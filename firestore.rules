rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validProfile() {
        return request.resource.data.keys().hasAll([
            'displayName', 'username', 'avatarUrl', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'displayName', 'username', 'avatarUrl', 'createdAt', 'updatedAt'
          ])
          && (request.resource.data.displayName == null
              || request.resource.data.displayName is string)
          && (request.resource.data.username == null
              || request.resource.data.username is string)
          && (request.resource.data.avatarUrl == null
              || request.resource.data.avatarUrl is string)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner()
        && validProfile()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /watchlist/{itemId} {
        function validWatchlist() {
          return request.resource.data.keys().hasAll([
              'tmdbId', 'mediaType', 'title', 'posterPath', 'releaseDate', 'addedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'tmdbId', 'mediaType', 'title', 'posterPath', 'releaseDate', 'addedAt'
            ])
            && request.resource.data.tmdbId is int
            && request.resource.data.tmdbId > 0
            && request.resource.data.mediaType in ['movie', 'tv']
            && request.resource.data.title is string
            && (request.resource.data.posterPath == null
                || request.resource.data.posterPath is string)
            && (request.resource.data.releaseDate == null
                || request.resource.data.releaseDate is string)
            && request.resource.data.addedAt == request.time;
        }

        allow get, list: if isOwner();
        allow create: if isOwner() && validWatchlist();
        allow delete: if isOwner();
        allow update: if false;
      }

      match /ratings/{itemId} {
        function validHalfStar(value) {
          return value is number && value >= 0.5 && value <= 5.0
            && value * 2 % 1 == 0;
        }

        function validPulseScore() {
          let score = request.resource.data.get('pulseScore', null);
          return score == null || (score is map
            && score.keys().hasOnly(['story', 'acting', 'visual', 'soundtrack'])
            && (score.get('story', null) == null || validHalfStar(score.story))
            && (score.get('acting', null) == null || validHalfStar(score.acting))
            && (score.get('visual', null) == null || validHalfStar(score.visual))
            && (score.get('soundtrack', null) == null || validHalfStar(score.soundtrack)));
        }

        function validRating() {
          return request.resource.data.keys().hasAll([
              'tmdbId', 'mediaType', 'title', 'posterPath',
              'rating', 'watchedAt', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'tmdbId', 'mediaType', 'title', 'posterPath',
              'rating', 'watchedAt', 'updatedAt', 'moodTags',
              'reviewText', 'containsSpoiler', 'pulseScore'
            ])
            && request.resource.data.tmdbId is int
            && request.resource.data.tmdbId > 0
            && request.resource.data.mediaType in ['movie', 'tv']
            && request.resource.data.title is string
            && (request.resource.data.posterPath == null
                || request.resource.data.posterPath is string)
            && validHalfStar(request.resource.data.rating)
            && request.resource.data.get('moodTags', []) is list
            && request.resource.data.get('moodTags', []).size() <= 3
            && request.resource.data.get('moodTags', []).hasOnly([
              'Tenso', 'Leve', 'Reflexivo', 'Épico', 'Emocionante'
            ])
            && request.resource.data.get('reviewText', '') is string
            && request.resource.data.get('reviewText', '').size() <= 2000
            && request.resource.data.get('containsSpoiler', false) is bool
            && validPulseScore();
        }

        allow get, list: if isOwner();
        allow create: if isOwner()
          && validRating()
          && request.resource.data.watchedAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner()
          && validRating()
          && request.resource.data.tmdbId == resource.data.tmdbId
          && request.resource.data.mediaType == resource.data.mediaType
          && request.resource.data.watchedAt == resource.data.watchedAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner();
      }
    }
  }
}
